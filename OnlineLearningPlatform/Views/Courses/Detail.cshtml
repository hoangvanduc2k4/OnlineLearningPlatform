@model OnlineLearningPlatform.Models.ViewModels.CourseDetailsViewModel
@{
    ViewData["Title"] = Model.CourseName;
    Func<decimal, string> FormatPrice = price => price == 0 ? "Miễn phí" : $"{price:N0} VNĐ";
}

<div class="container mt-4">

    <div class="row">
        <div class="col-lg-8">
            <h1 class="display-5 fw-bold">@Model.CourseName</h1>
            <p class="text-muted">
                Được tạo bởi
                <a href="#">
                    <img src="@(Model.MentorAvatarUrl ?? "/images/default-avatar.png")" alt="Avatar giảng viên" class="mentor-avatar">
                    @Model.MentorName
                </a>
            </p>

            <hr>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow mb-4" alt="Ảnh bìa khóa học @Model.CourseName">
            }

            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Mô tả khóa học</h4>
                </div>
                <div class="card-body">
                    <p>@Model.Description</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow position-sticky" style="top: 20px;">
                <div class="card-body">
                    <h3 class="card-title">Thông tin</h3>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        @if (Model.Discount > 0)
                        {
                            var discountedPrice = Model.Price - (Model.Price * (decimal)Model.Discount / 100);
                            <span class="h4 text-danger fw-bold">@FormatPrice(discountedPrice)</span>
                            <span class="h5 text-muted text-decoration-line-through">@FormatPrice(Model.Price)</span>
                        }
                        else
                        {
                            <span class="h4 text-primary fw-bold">@FormatPrice(Model.Price)</span>
                        }
                    </div>

                    <div class="d-grid gap-2">
                        <a href="#" class="btn btn-primary btn-lg">Đăng ký học</a>
                    </div>

                    <hr>

                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>Trình độ:</strong> @Model.LevelName</li>
                        <li class="mb-2"><strong>Thời lượng:</strong> @Model.StudyTime giờ</li>
                        <li class="mb-2"><strong>Bài kiểm tra:</strong> @Model.TotalQuizCount quizzes</li>
                        <li class="mb-2"><strong>Cập nhật lần cuối:</strong> @Model.UpdatedAt?.ToString("dd/MM/yyyy")</li>
                        <li class="mb-2">
                            <strong>Danh mục:</strong>
                            @foreach (var category in Model.CategoryNames)
                            {
                                <span class="badge bg-secondary">@category</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-5">

    <div class="row">
        <div class="col-lg-8">
            <h2>Chương trình học</h2>
            @if (Model.Modules.Any())
            {
                <div class="accordion" id="courseModulesAccordion">
                    @foreach (var module in Model.Modules.OrderBy(m => m.ModuleNumber))
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading-@module.ModuleId">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@module.ModuleId" aria-expanded="false" aria-controls="collapse-@module.ModuleId">
                                    <strong>Module @module.ModuleNumber: @module.ModuleName</strong>
                                </button>
                            </h2>
                            <div id="collapse-@module.ModuleId" class="accordion-collapse collapse" aria-labelledby="heading-@module.ModuleId" data-bs-parent="#courseModulesAccordion">
                                <div class="accordion-body">
                                    <ul class="list-group list-group-flush">
                                        @foreach (var lesson in module.Lessons.OrderBy(l => l.LessonNumber))
                                        {
                                            <li class="list-group-item">[Bài học] @lesson.LessonName (@lesson.Duration phút)</li>
                                        }
                                        @foreach (var quiz in module.Quizzes)
                                        {
                                            <li class="list-group-item fw-bold">[Bài quiz] @quiz.QuizName</li>
                                            @if (quiz.Questions.Any())
                                            {
                                                <ul class="list-group list-group-flush ms-4">
                                                    @foreach (var question in quiz.Questions.OrderBy(q => q.QuestionNum))
                                                    {
                                                        <li class="list-group-item fst-italic">-- Câu @question.QuestionNum: @question.QuestionContent</li>
                                                    }
                                                </ul>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>Nội dung khóa học đang được cập nhật.</p>
            }
        </div>
    </div>

    <hr class="my-5">

    <div class="row">
        <div class="col-lg-8">
            <h2>Đánh giá từ học viên</h2>
            @if (Model.Ratings.Any())
            {
                <div class="card bg-light mb-4">
                    <div class="card-body text-center">
                        <h4 class="card-title">Tổng quan</h4>
                        <span class="display-4">@Model.AverageRating.ToString("0.0")</span>
                        <span class="text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fa @(i <= Math.Round(Model.AverageRating) ? "fa-star" : "fa-star-o")"></i>
                            }
                        </span>
                        <p class="text-muted">(@Model.FeedbackCount đánh giá)</p>
                    </div>
                </div>
                @foreach (var rating in Model.Ratings)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex">
                                <div class="flex-shrink-0 text-center me-3">
                                    <img src="@(rating.UserAvatarUrl ?? "/images/default-avatar.png")" alt="Avatar của @rating.UserName" class="rating-avatar mb-1">
                                    <strong class="d-block">@rating.UserName</strong>
                                    <small class="text-muted">@rating.FeedbackDate.ToString("dd/MM/yyyy")</small>
                                </div>
                                <div class="flex-grow-1">
                                    <span class="text-warning">
                                        @for (int i = 0; i < rating.RatingValue; i++)
                                        {
                                            <i class="fa fa-star"></i>
                                        }
                                        @for (int i = 0; i < 5 - rating.RatingValue; i++)
                                        {
                                            <i class="fa fa-star-o"></i>
                                        }
                                    </span>
                                    <p class="mt-2 mb-0">@rating.Feedback</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Chưa có đánh giá nào cho khóa học này.</p>
            }
        </div>
    </div>
</div>


@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <style>
        .mentor-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 8px;
        }

        .fa-star { color: #ffc107; }
        .fa-star-o { color: #e4e5e9; }

        .rating-avatar { /* <-- Thêm class này */
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
        }

        .fa-star {
            color: #ffc107;
        }

        .fa-star-o {
            color: #e4e5e9;
        }
    </style>
}
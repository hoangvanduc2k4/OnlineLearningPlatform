@if (User.Identity.IsAuthenticated && (User.IsInRole("Mentor") || User.IsInRole("Mentee")))
{
    <div id="chat-bubble" style="position: fixed; bottom: 30px; right: 30px; z-index: 2000;">
        <button id="chat-bubble-btn"
                style="background-color: #007bff; color: white; border: none; border-radius: 50%; width: 60px; height: 60px; cursor: pointer; box-shadow: 0 0 10px rgba(0,0,0,0.3);">
            💬
        </button>
    </div>
    <div id="chat-popup" class="chat-popup d-none">
        <div class="chat-popup-header">
            <span>AI Assistant</span>
            <button id="chat-popup-close" style="background: none; border: none; font-size: 1.2em; cursor: pointer;">&times;</button>
        </div>
        <div class="chat-popup-body">
            <div class="chatbot-buttons">
                @if (User.IsInRole("Mentor"))
                {
                    <button type="button" data-function="generate-lesson">Generate Lesson</button>
                    <button type="button" data-function="generate-quiz">Generate Quiz</button>
                }
                @if (User.IsInRole("Mentee"))
                {
                    <button type="button" data-function="ask-quiz">Ask Quiz</button>
                    <button type="button" data-function="summarize">Summarize/Explain</button>
                }
            </div>
            <div id="chatbot-input" class="d-none">
                <textarea id="chatbot-textarea" class="chat-input" placeholder="Enter content."></textarea>
                <input id="num-questions" type="number" min="1" max="10" class="d-none" placeholder="Number question">
                <select id="summarize-or-explain" class="d-none">
                    <option value="true">Summarize</option>
                    <option value="false">Explain</option>
                </select>
                <button id="submit-chatbot" class="chat-send-btn">Send <span class="spinner d-none">⏳</span></button>
            </div>
            <div id="chatbot-response" class="chat-messages"></div>
        </div>
    </div>
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KnowHub</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/9.0.6/signalr.min.js" integrity="sha512-kkMt8UThSmWcdXLYFaGZ/U6vyWSNLZMUWQ5SMeF80pGqrEkH5ei9D/3MbVQpB8p7D5C3A4vlX7BpsWTT2BfB6A==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <meta name="description" content="">
    <meta name="keywords" content="">

    <!-- Favicons -->
    <link href="~/img/favicon.png" rel="icon">
    <link href="~/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <!-- Main CSS File -->
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true">

    <!-- Chatbot CSS -->
    <link href="~/css/chatbot.css" rel="stylesheet" asp-append-version="true">
</head>

<body>
    <header id="header" class="header d-flex align-items-center sticky-top">
        <div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-center">
            <a class="logo d-flex align-items-center me-auto" asp-controller="Home" asp-action="Index">
                <h1 class="sitename">KnowHub</h1>
            </a>
            <nav id="navmenu" class="navmenu mx-auto">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index" class="active">Home</a></li> @*<-- Thêm asp-area="" *@
                    <li><a asp-area="" asp-controller="Courses" asp-action="Index">Courses</a></li> @*<-- Thêm asp-area="" *@
                    <li><a asp-area="" asp-controller="Mentors" asp-action="Index">Mentors</a></li> @*<-- Thêm asp-area="" *@
                    <li><a asp-area="" asp-controller="FAQs" asp-action="Index">FAQs</a></li> @*<-- Thêm asp-area="" *@
                    <li><a asp-area="" asp-controller="Contact" asp-action="Index">Contact</a></li> @*<-- Thêm asp-area="" *@
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>
            <partial name="_LoginPartial" />
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer id="footer" class="footer accent-background">
        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-6 col-md-12 footer-about">
                    <a class="logo d-flex align-items-center" asp-controller="Home" asp-action="Index">
                        <span class="sitename">OnlineLearningPlatform</span>
                    </a>
                    <p>© 2025 - OnlineLearningPlatform. All Rights Reserved.</p>
                    <div class="social-links d-flex mt-4">
                        <a href=""><i class="bi bi-twitter-x"></i></a>
                        <a href=""><i class="bi bi-facebook"></i></a>
                        <a href=""><i class="bi bi-instagram"></i></a>
                        <a href=""><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div class="col-lg-3 col-6 footer-links">
                    <h4>Useful Links</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                        <li><a href="terms.html">Terms</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-12 footer-contact text-center text-md-start">
                    <h4>Contact Us</h4>
                    <p>A108 Adam Street</p>
                    <p>New York, NY 535022</p>
                    <p>United States</p>
                    <p class="mt-4"><strong>Phone:</strong> <span>+1 5589 55488 55</span></p>
                    <p><strong>Email:</strong> <span>info@example.com</span></p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Chatbot HTML -->
    @if (User.Identity.IsAuthenticated && (User.IsInRole("Mentor") || User.IsInRole("Mentee")))
    {
        <div id="chat-bubble" style="position: fixed; bottom: 30px; right: 30px; z-index: 2000;">
            <button id="chat-bubble-btn"
                    style="background-color: #007bff; color: white; border: none; border-radius: 50%; width: 60px; height: 60px; cursor: pointer; box-shadow: 0 0 10px rgba(0,0,0,0.3);">
                💬
            </button>
        </div>
        <div id="chat-popup" class="chat-popup d-none">
            <div class="chat-popup-header">
                <span>AI Assistant</span>
                <button id="chat-popup-close" style="background: none; border: none; font-size: 1.2em; cursor: pointer;">&times;</button>
            </div>
            <div class="chat-popup-body">
                <div class="chatbot-buttons">
                    @if (User.IsInRole("Mentor"))
                    {
                        <button type="button" data-function="generate-lesson">Generate Lesson</button>
                        <button type="button" data-function="generate-quiz">Generate Quiz</button>
                    }
                    @if (User.IsInRole("Mentee"))
                    {
                        <button type="button" data-function="ask-quiz">Ask Quiz</button>
                        <button type="button" data-function="summarize">Summarize/Explain</button>
                    }
                </div>
                <div id="chatbot-input" class="d-none">
                    <textarea id="chatbot-textarea" class="chat-input" placeholder="Enter content."></textarea>
                    <input id="num-questions" type="number" min="1" max="10" class="d-none" placeholder="Number question">
                    <select id="summarize-or-explain" class="d-none">
                        <option value="true">Summarize</option>
                        <option value="false">Explain</option>
                    </select>
                    <button id="submit-chatbot" class="chat-send-btn">Send <span class="spinner d-none">⏳</span></button>
                </div>
                <div id="chatbot-response" class="chat-messages"></div>
            </div>
        </div>
    }

    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
    <div id="preloader"></div>

    <!-- Vendor JS Files -->
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/php-email-form/validate.js"></script>
    <script src="~/vendor/aos/aos.js"></script>
    <script src="~/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/vendor/swiper/swiper-bundle.min.js"></script>

    <!-- Main JS File -->
    <script src="~/js/main.js" asp-append-version="true"></script>

    <!-- Original scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
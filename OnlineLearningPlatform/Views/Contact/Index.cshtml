@model OnlineLearningPlatform.Models.ContactViewModel
@{
	ViewData["Title"] = "Contact";
}

<div class="page-title light-background">
	<div class="container d-lg-flex justify-content-between align-items-center">
		<h1 class="mb-2 mb-lg-0">Contact</h1>
		<nav class="breadcrumbs">
			<ol>
				<li><a href="index.html">Home</a></li>
				<li class="current">Contact</li>
			</ol>
		</nav>
	</div>
</div>
<section id="contact" class="contact section">

	<div class="container" data-aos="fade-up" data-aos-delay="100">
		<div class="contact-main-wrapper">
			<div class="map-wrapper">
				<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3540.2208718984934!2d105.52271427503096!3d21.012416680632853!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135abc60e7d3f19%3A0x2be9d7d0b5abcbf4!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBGUFQgSMOgIE7hu5lp!5e1!3m2!1svi!2s!4v1758389304345!5m2!1svi!2s" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
			</div>

			<div class="contact-content">
				<div class="contact-cards-container" data-aos="fade-up" data-aos-delay="300">
					<div class="contact-card">
						<div class="icon-box">
							<i class="bi bi-geo-alt"></i>
						</div>
						<div class="contact-text">
							<h4>Location</h4>
							<p>8721 Broadway Avenue, New York, NY 10023</p>
						</div>
					</div>

					<div class="contact-card">
						<div class="icon-box">
							<i class="bi bi-envelope"></i>
						</div>
						<div class="contact-text">
							<h4>Email</h4>
							<p>info@examplecompany.com</p>
						</div>
					</div>

					<div class="contact-card">
						<div class="icon-box">
							<i class="bi bi-telephone"></i>
						</div>
						<div class="contact-text">
							<h4>Call</h4>
							<p>+1 (212) 555-7890</p>
						</div>
					</div>

					<div class="contact-card">
						<div class="icon-box">
							<i class="bi bi-clock"></i>
						</div>
						<div class="contact-text">
							<h4>Open Hours</h4>
							<p>Monday-Friday: 9AM - 5PM</p>
						</div>
					</div>
				</div>

				<div class="contact-form-container" data-aos="fade-up" data-aos-delay="400">
					<h3 class="mb-3">Get in Touch</h3>
					<p class="text-muted">Have a question or comment? Leave us a message and we will get back to you as soon as possible.</p>

					<form asp-controller="Contact" asp-action="Index" method="post" role="form">
						@Html.AntiForgeryToken()

						@if (ViewBag.StatusMessage != null)
						{
							var statusMessageClass = ((string)ViewBag.StatusMessage).StartsWith("Error") ? "alert alert-danger my-3" : "alert alert-success my-3";
							<div class="@statusMessageClass" role="alert">
								@ViewBag.StatusMessage
							</div>
						}

						<div class="row gx-3">
							<div class="col-md-6">
								<input type="text" asp-for="Name" class="form-control rounded-3 py-3" placeholder="Your Name">
								<span asp-validation-for="Name" class="text-danger"></span>
							</div>
							<div class="col-md-6 mt-3 mt-md-0">
								<input type="email" asp-for="Email" class="form-control rounded-3 py-3" placeholder="Your Email">
								<span asp-validation-for="Email" class="text-danger"></span>
							</div>
						</div>

						<div class="mt-3">
							<input type="text" asp-for="Subject" class="form-control rounded-3 py-3" placeholder="Subject">
							<span asp-validation-for="Subject" class="text-danger"></span>
						</div>

						<div class="mt-3">
							<textarea asp-for="Message" class="form-control rounded-3 py-3" rows="5" placeholder="Message"></textarea>
							<span asp-validation-for="Message" class="text-danger"></span>
						</div>

						<div class="d-flex justify-content-between align-items-center mt-4">
							<button type="submit" class="btn btn-primary px-5 py-3 rounded-pill fw-semibold">Send Message</button>

							<div class="social-links">
								<a href="#" class="fs-5 mx-2"><i class="bi bi-twitter"></i></a>
								<a href="#" class="fs-5 mx-2"><i class="bi bi-facebook"></i></a>
								<a href="#" class="fs-5 mx-2"><i class="bi bi-instagram"></i></a>
								<a href="#" class="fs-5 mx-2"><i class="bi bi-linkedin"></i></a>
							</div>
						</div>
					</form>
				</div>



			</div>
		</div>
	</div>
</section>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
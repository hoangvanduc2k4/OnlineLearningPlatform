@{
    ViewData["Title"] = "Home Page";
}
@using OnlineLearningPlatform.Models.ViewModels
@{
    ViewData["Title"] = "Home Page";

    var topCourses = ViewBag.TopCourses as List<CourseViewModel> ?? new List<CourseViewModel>();
    var topMentors = ViewBag.TopMentors as List<InstructorViewModel> ?? new List<InstructorViewModel>();
}
<section id="courses-hero" class="courses-hero section light-background">
    <div class="hero-content">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="hero-text">
                        <h1>Transform Your Future with Expert-Led Online Courses</h1>
                        <p>
                            Discover thousands of high-quality courses designed by
                            industry professionals. Learn at your own pace, gain
                            in-demand skills, and advance your career from anywhere in
                            the world.
                        </p>

                        <div class="hero-stats">
                            <div class="stat-item">
                                <span class="number purecounter"
                                      data-purecounter-start="0"
                                      data-purecounter-end="50000"
                                      data-purecounter-duration="2"></span>
                                <span class="label">Students Enrolled</span>
                            </div>
                            <div class="stat-item">
                                <span class="number purecounter"
                                      data-purecounter-start="0"
                                      data-purecounter-end="1200"
                                      data-purecounter-duration="2"></span>
                                <span class="label">Expert Courses</span>
                            </div>
                            <div class="stat-item">
                                <span class="number purecounter"
                                      data-purecounter-start="0"
                                      data-purecounter-end="98"
                                      data-purecounter-duration="2"></span>
                                <span class="label">Success Rate %</span>
                            </div>
                        </div>

                        <div class="hero-buttons">
                            <a href="#courses" class="btn btn-primary">Browse Courses</a>
                            <a href="#about" class="btn btn-outline">Learn More</a>
                        </div>

                        <div class="hero-features">
                            <div class="feature">
                                <i class="bi bi-shield-check"></i>
                                <span>Certified Programs</span>
                            </div>
                            <div class="feature">
                                <i class="bi bi-clock"></i>
                                <span>Lifetime Access</span>
                            </div>
                            <div class="feature">
                                <i class="bi bi-people"></i>
                                <span>Expert Instructors</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="hero-image">
                        <div class="main-image">
                            <img src="~/img/education/courses-13.webp"
                                 alt="Online Learning"
                                 class="img-fluid" />
                        </div>

                        <div class="floating-cards">
                            <div class="course-card"
                                 data-aos="fade-up"
                                 data-aos-delay="300">
                                <div class="card-icon">
                                    <i class="bi bi-code-slash"></i>
                                </div>
                                <div class="card-content">
                                    <h6>Web Development</h6>
                                    <span>2,450 Students</span>
                                </div>
                            </div>

                            <div class="course-card"
                                 data-aos="fade-up"
                                 data-aos-delay="400">
                                <div class="card-icon">
                                    <i class="bi bi-palette"></i>
                                </div>
                                <div class="card-content">
                                    <h6>UI/UX Design</h6>
                                    <span>1,890 Students</span>
                                </div>
                            </div>

                            <div class="course-card"
                                 data-aos="fade-up"
                                 data-aos-delay="500">
                                <div class="card-icon">
                                    <i class="bi bi-graph-up"></i>
                                </div>
                                <div class="card-content">
                                    <h6>Digital Marketing</h6>
                                    <span>3,200 Students</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="hero-background">
        <div class="bg-shapes">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>
    </div>
</section>
<section id="featured-courses" class="featured-courses section">
    <div class="container section-title" data-aos="fade-up">
        <h2>Featured Courses</h2>
        <p>
            Start learning in-demand skills with our handpicked selection of top-rated programs.
        </p>
    </div>
    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="d-flex flex-nowrap overflow-x-auto py-3" style="gap: 1.5rem;">
            @foreach (var course in topCourses)
            {
                var cat = (course.CategoryNames != null && course.CategoryNames.Any())
                ? string.Join(", ", course.CategoryNames)
                : "Programming";

                var level = !string.IsNullOrWhiteSpace(course.LevelName) ? course.LevelName : "Intermediate";

                var duration = !string.IsNullOrWhiteSpace(course.StudyTime) ? course.StudyTime : "100";

                var students = course.GetType().GetProperty("StudentsCount")?.GetValue(course)?.ToString() ?? "1,000";
                var rating = course.GetType().GetProperty("Rating")?.GetValue(course)?.ToString() ?? "4.6";

                var instructor = !string.IsNullOrWhiteSpace(course.MentorName) ? course.MentorName
                : (course.GetType().GetProperty("InstructorName")?.GetValue(course)?.ToString() ?? "Instructor");

                var instructorImgRaw = !string.IsNullOrWhiteSpace(course.MentorAvatarUrl) ? course.MentorAvatarUrl
                : (course.GetType().GetProperty("InstructorImageUrl")?.GetValue(course)?.ToString() ?? "~/assets/img/person/person-m-3.webp");
                var instructorImg = Url.Content(instructorImgRaw);

                var badge = course.GetType().GetProperty("Badge")?.GetValue(course)?.ToString() ?? "";

                decimal price = course.Price;
                decimal? discount = course.Discount;

                bool hasDiscount = discount.HasValue && discount.Value > 0;
                var discountedPrice = hasDiscount ? (price - discount.Value) : price;

                var priceStr = (discountedPrice <= 0) ? "Free" : discountedPrice.ToString("C");
                var originalPriceStr = price > 0 ? price.ToString("C") : "Free";
                var isFree = (badge?.ToLower().Contains("free") == true) || (price <= 0);

                var imgUrlRaw = !string.IsNullOrEmpty(course.ImageUrl) ? course.ImageUrl : "~/assets/img/education/courses-3.webp";
                var imgUrl = Url.Content(imgUrlRaw);

                <div style="width: 400px; flex-shrink: 0;">
                    <div class="course-card">

                        <div class="course-image">

                            <img src="@imgUrl" alt="Course" class="img-fluid">


                            @if (hasDiscount && !isFree)
                            {
                                <div class="course-price">
                                    <span class="fw-bold">@priceStr</span>
                                    <small class="text-muted text-decoration-line-through ms-2">
                                        @originalPriceStr
                                    </small>
                                </div>
                            }
                            else if (!hasDiscount && !isFree)
                            {
                                <div class="course-price">
                                    @originalPriceStr
                                </div>

                            }
                            else if (isFree)
                            {
                                <div class="course-price">Free</div>
                            }

                        </div>

                        <div class="course-content card-body d-flex flex-column">

                            <div class="course-meta">
                                @foreach (var cname in course.CategoryNames)
                                {
                                    <span class="category">@cname</span>
                                }
                                <span class="level">@level</span>
                            </div>

                            <h3 class="h5">@course.CourseName</h3>
                            <p class="text-muted mb-3">@course.Description</p>

                            <div class="course-stats d-flex justify-content-between align-items-center small text-muted mb-3">
                                <div class="stat">
                                    <i class="bi bi-clock me-1"></i>
                                    <span>@(string.IsNullOrEmpty(duration) ? "— hours" : duration + " hours")</span>
                                </div>
                                <div class="stat">
                                    <i class="bi bi-people me-1"></i>
                                    <span>@students students</span>
                                </div>
                                <div class="rating">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-half"></i>
                                    <span class="ms-1">@rating</span>
                                </div>
                            </div>

                            <div class="instructor-info d-flex align-items-center mb-3">
                                <img src="@instructorImg" alt="Instructor" class="instructor-avatar rounded-circle me-2" style="width:40px;height:40px;object-fit:cover;">
                                <span class="instructor-name small text-muted">@instructor</span>
                            </div>

                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseId" class="btn-course">View Detail</a>
                        </div>
                    </div>
                </div>

            }
        </div> <div class="more-courses text-center"
                    data-aos="fade-up"
                    data-aos-delay="500">
            <a asp-controller="Courses" asp-action="Index" class="btn-more">View All Courses</a>
        </div>
    </div>
</section>
<section id="course-categories" class="course-categories section">
    <div class="container section-title" data-aos="fade-up">
        <h2>Course Categories</h2>
        <p>
            Browse our wide range of subjects and find the perfect topic to spark your curiosity.
        </p>
    </div>
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row g-4">

            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"
                 data-aos="zoom-in"
                 data-aos-delay="100">
                <a asp-controller="Courses" asp-action="Index" class="category-card category-tech">
                    <div class="category-icon">
                        <i class="bi bi-laptop"></i>
                    </div>
                    <h5>Computer Science</h5>
                    <span class="course-count">24 Courses</span>
                </a>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"
                 data-aos="zoom-in"
                 data-aos-delay="150">
                <a asp-controller="Courses" asp-action="Index" class="category-card category-business">
                    <div class="category-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>
                    <h5>Business</h5>
                    <span class="course-count">18 Courses</span>
                </a>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"
                 data-aos="zoom-in"
                 data-aos-delay="200">
                <a asp-controller="Courses" asp-action="Index" class="category-card category-design">
                    <div class="category-icon">
                        <i class="bi bi-palette"></i>
                    </div>
                    <h5>Design</h5>
                    <span class="course-count">15 Courses</span>
                </a>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"
                 data-aos="zoom-in"
                 data-aos-delay="250">
                <a asp-controller="Courses" asp-action="Index" class="category-card category-health">
                    <div class="category-icon">
                        <i class="bi bi-heart-pulse"></i>
                    </div>
                    <h5>Health &amp; Medical</h5>
                    <span class="course-count">12 Courses</span>
                </a>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"
                 data-aos="zoom-in"
                 data-aos-delay="300">
                <a asp-controller="Courses" asp-action="Index" class="category-card category-language">
                    <div class="category-icon">
                        <i class="bi bi-globe"></i>
                    </div>
                    <h5>Languages</h5>
                    <span class="course-count">21 Courses</span>
                </a>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6"
                 data-aos="zoom-in"
                 data-aos-delay="350">
                <a asp-controller="Courses" asp-action="Index" class="category-card category-science">
                    <div class="category-icon">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                    <h5>Science</h5>
                    <span class="course-count">16 Courses</span>
                </a>
            </div>
        </div>
    </div>
</section>
<section id="featured-instructors" class="featured-instructors section">
    <div class="container section-title" data-aos="fade-up">
        <h2>Featured Mentors</h2>
        <p>
            Meet the top-rated mentors and innovators ready to guide you on your learning journey.
        </p>
    </div>
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="d-flex flex-nowrap overflow-x-auto py-3" style="gap: 1.5rem;">
            @foreach (var item in topMentors)
            {
                <div data-aos="fade-up" data-aos-delay="200" style="width: 280px; flex-shrink: 0;">
                    <div class="instructor-card">
                        <div class="instructor-image">
                            <img src="@item.ImageUrl" class="img-fluid" alt="Profile image of @item.FullName">
                            <div class="overlay-content">
                                <div class="course-count">
                                    <i class="bi bi-play-circle"></i>
                                    <span>@item.CourseCount Courses</span>
                                </div>
                            </div>
                        </div>
                        <div class="instructor-info card shadow-sm border-0 text-center p-3" style="max-width: 300px; border-radius: 15px;">
                            <h5 class="card-title mb-2">@item.FullName</h5>

                            <div class="stats-grid d-flex justify-content-between align-items-center mt-3 px-2">
                                <div class="stat">
                                    <span class="number fw-bold fs-5">@item.StudentCount</span><br>
                                    <span class="label text-muted small">Students</span>
                                </div>

                                <div class="social-links d-flex gap-3">
                                    <a href="#" class="text-dark" style="font-size: 1.3rem;">
                                        <i class="bi bi-instagram"></i>
                                    </a>
                                    <a href="#" class="text-dark" style="font-size: 1.3rem;">
                                        <i class="bi bi-facebook"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            }
        </div>
    </div>
</section>
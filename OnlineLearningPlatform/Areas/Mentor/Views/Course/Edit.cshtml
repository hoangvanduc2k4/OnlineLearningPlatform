@model OnlineLearningPlatform.Models.ViewModels.CourseEditViewModel

@{
    ViewData["Title"] = "Edit Course";
    Layout = "~/Areas/Mentor/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary">Edit Course</h5>
                    <a asp-page="/Courses/Manage" asp-area="Mentor" asp-route-id="@Model.CourseId"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" asp-for="CourseId" />

                        <div class="form-group mb-3">
                            <label asp-for="CourseName" class="form-label"></label>
                            <input asp-for="CourseName" class="form-control" />
                            <span asp-validation-for="CourseName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="StudyTime" class="form-label"></label>
                            <input asp-for="StudyTime" class="form-control" />
                            <span asp-validation-for="StudyTime" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Price" class="form-label"></label>
                                    <div class="input-group">
                                        <input type="hidden" asp-for="Price" />
                                        <input id="Price-display" class="form-control" type="text" inputmode="numeric" placeholder="" />
                                        <span class="input-group-text">VND</span>
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Discount" class="control-label"></label>
                                    <div class="input-group">
                                        <input type="hidden" asp-for="Discount" />
                                        <input id="Discount-display" class="form-control" type="text" inputmode="numeric" placeholder="0" />
                                        <span class="input-group-text">VND</span>
                                    </div>
                                    <span asp-validation-for="Discount" class="text-danger"></span>
                                    <span id="discount-validation-message" class="text-danger d-block"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="LevelId" class="form-label"></label>
                            <select asp-for="LevelId" class="form-select" asp-items="@Model.Levels">
                                <option value="">-- Select Level --</option>
                            </select>
                            <span asp-validation-for="LevelId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="AllCategories" class="form-label"></label>
                            <div class="border p-3 rounded" style="max-height: 200px; overflow-y: auto; background-color: #f8f9fa;">
                                @for (var i = 0; i < Model.AllCategories.Count; i++)
                                {
                                    <div class="form-check">
                                        <input type="hidden" asp-for="@Model.AllCategories[i].Id" />
                                        <input type="hidden" asp-for="@Model.AllCategories[i].Name" />
                                        <input type="checkbox" asp-for="@Model.AllCategories[i].IsSelected" class="form-check-input" />
                                        <label class="form-check-label" asp-for="@Model.AllCategories[i].IsSelected">
                                            @Model.AllCategories[i].Name
                                        </label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="AllCategories" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3 border p-3 rounded">
                            <label class="form-label fw-bold">Cover Image</label>

                            <div class="mb-3">
                                <label class="form-label text-muted">Current Image</label>
                                @if (!string.IsNullOrEmpty(Model.ExistingCoverImageUrl))
                                {
                                    <img src="@Model.ExistingCoverImageUrl" class="img-fluid rounded border d-block" style="max-height: 200px;" alt="Current Cover Image" />
                                }
                                else
                                {
                                    <p class="text-muted fst-italic">No image has been uploaded.</p>
                                }
                            </div>

                            <label class="form-label fw-bold">Update Image</label>
                            <div class="mb-3 text-center">
                                <img id="image-preview" src="#" alt="New image preview" class="img-fluid rounded border" style="display: none; max-height: 250px; border-color: #dee2e6!important;" />
                                
                            </div>

                            <div class="form-check">
                                <input type="radio" asp-for="ImageOption" value="file" class="form-check-input" id="ImageOptionFile" checked />
                                <label class="form-check-label" for="ImageOptionFile">Upload New File</label>
                            </div>
                            <div class="form-check">
                                <input type="radio" asp-for="ImageOption" value="url" class="form-check-input" id="ImageOptionUrl" />
                                <label class="form-check-label" for="ImageOptionUrl">Enter New URL</label>
                            </div>

                            <div id="file-upload-section" class="mt-2">
                                <label asp-for="NewCoverImage" class="control-label"></label>
                                <input asp-for="NewCoverImage" class="form-control" type="file" accept="image/*" />
                                <span asp-validation-for="NewCoverImage" class="text-danger"></span>
                            </div>

                            <div id="url-input-section" class="mt-2" style="display: none;">
                                <label asp-for="CoverImageUrl" class="control-label"></label>
                                <input asp-for="CoverImageUrl" class="form-control" placeholder="" />
                                <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group d-flex justify-content-end gap-2">
                            @if (Model.CurrentStatus == CourseStatus.Draft || Model.CurrentStatus == CourseStatus.Rejected || Model.CurrentStatus == CourseStatus.Approved)
                            {
                                <button type="submit" name="action" value="save_draft" class="btn btn-secondary"><i class="bi bi-save"></i> Save as Draft</button>
                                <button type="submit" name="action" value="submit_review" class="btn btn-primary"><i class="bi bi-send"></i> Submit for Review</button>
                            }
                            <a asp-page="/Courses/Manage" asp-area="Mentor" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const imageOptionRadios = document.querySelectorAll('input[name="@Html.NameFor(m => m.ImageOption)"]');
            const fileUploadSection = document.getElementById('file-upload-section');
            const urlInputSection = document.getElementById('url-input-section');
            const fileInput = document.getElementById('@Html.IdFor(m => m.NewCoverImage)'); 
            const urlInput = document.getElementById('@Html.IdFor(m => m.CoverImageUrl)');
            const imagePreview = document.getElementById('image-preview');
            const previewPlaceholder = document.getElementById('preview-placeholder'); 

            function showPreview(src) {
                if (src) {
                    imagePreview.src = src;
                    imagePreview.style.display = 'block';
                    if (previewPlaceholder) previewPlaceholder.style.display = 'none';
                } else {
                    imagePreview.src = '#';
                    imagePreview.style.display = 'none';
                    if (previewPlaceholder) previewPlaceholder.style.display = 'flex';
                }
            }

            function toggleImageInputs() {
                const selectedValue = document.querySelector('input[name="@Html.NameFor(m => m.ImageOption)"]:checked').value;
                if (selectedValue === 'file') {
                    fileUploadSection.style.display = 'block';
                    urlInputSection.style.display = 'none';
                    if (urlInput) urlInput.value = '';
                    if (fileInput && fileInput.files && fileInput.files[0]) {
                        const reader = new FileReader();
                        reader.onload = function (e) { showPreview(e.target.result); };
                        reader.readAsDataURL(fileInput.files[0]);
                    } else {
                        showPreview(null);
                    }
                } else { // 'url'
                    fileUploadSection.style.display = 'none';
                    urlInputSection.style.display = 'block';
                    if (fileInput) fileInput.value = null;
                    if (urlInput && urlInput.value) {
                        showPreview(urlInput.value);
                    } else {
                        showPreview(null);
                    }
                }
            }

            imageOptionRadios.forEach(radio => radio.addEventListener('change', toggleImageInputs));
            if (fileInput) fileInput.addEventListener('change', function (e) {
                if (e.target.files && e.target.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function (e) { showPreview(e.target.result); };
                    reader.readAsDataURL(e.target.files[0]);
                }
            });
            if (urlInput) urlInput.addEventListener('input', function (e) {
                if (e.target.value.startsWith('http://') || e.target.value.startsWith('https://')) {
                     showPreview(e.target.value);
                } else {
                     showPreview(null);
                }
            });
            toggleImageInputs();
            showPreview(null); 



            const vndFormatter = new Intl.NumberFormat('de-DE');

            const hiddenPriceInput = document.getElementById('@Html.IdFor(m => m.Price)');
            const visiblePriceInput = document.getElementById('Price-display');

            const hiddenDiscountInput = document.getElementById('@Html.IdFor(m => m.Discount)');
            const visibleDiscountInput = document.getElementById('Discount-display');
            const discountValidationSpan = document.getElementById('discount-validation-message');

            function formatVisiblePrice() {
                let cursorPosition = visiblePriceInput.selectionStart;
                let originalValue = visiblePriceInput.value;
                let originalLength = originalValue.length;
                let numericValueStr = originalValue.replace(/[^0-9]/g, '');
                let numValue = parseFloat(numericValueStr);
                hiddenPriceInput.value = numericValueStr;
                let formattedValue = '';
                if (!isNaN(numValue) && numValue !== 0) {
                    formattedValue = vndFormatter.format(numValue);
                } else {
                    hiddenPriceInput.value = '';
                }
                visiblePriceInput.value = formattedValue;
                let newLength = formattedValue.length;
                let newCursorPosition = cursorPosition + (newLength - originalLength);
                if (newCursorPosition >= 0) {
                     visiblePriceInput.setSelectionRange(newCursorPosition, newCursorPosition);
                }
            }
            function initializePrice() {
                let initialValue = hiddenPriceInput.value;
                if (initialValue) {
                    let numValue = parseFloat(initialValue);
                    if (!isNaN(numValue) && numValue !== 0) {
                        visiblePriceInput.value = vndFormatter.format(numValue);
                    } else {
                        visiblePriceInput.value = '';
                    }
                }
            }

            function formatVisibleDiscount() {
                let cursorPosition = visibleDiscountInput.selectionStart;
                let originalValue = visibleDiscountInput.value;
                let originalLength = originalValue.length;
                let numericValueStr = originalValue.replace(/[^0-9]/g, '');
                let numValue = parseFloat(numericValueStr);
                hiddenDiscountInput.value = numericValueStr;
                let formattedValue = '';
                if (!isNaN(numValue) && numValue !== 0) {
                    formattedValue = vndFormatter.format(numValue);
                } else {
                    hiddenDiscountInput.value = '';
                }
                visibleDiscountInput.value = formattedValue;
                let newLength = formattedValue.length;
                let newCursorPosition = cursorPosition + (newLength - originalLength);
                if (newCursorPosition >= 0) {
                    visibleDiscountInput.setSelectionRange(newCursorPosition, newCursorPosition);
                }
            }
            function initializeDiscount() {
                let initialValue = hiddenDiscountInput.value;
                if (initialValue) {
                    let numValue = parseFloat(initialValue);
                    if (!isNaN(numValue) && numValue !== 0) {
                        visibleDiscountInput.value = vndFormatter.format(numValue);
                    } else {
                        visibleDiscountInput.value = '';
                    }
                }
            }

            function validatePriceVsDiscount() {
                const priceVal = parseFloat(hiddenPriceInput.value) || 0;
                const discountVal = parseFloat(hiddenDiscountInput.value) || 0;

                if (discountVal > 0 && priceVal > 0 && discountVal > priceVal) {
                    discountValidationSpan.textContent = 'Discount price cannot be higher than the original price.';
                    visibleDiscountInput.classList.add('is-invalid');
                } else {
                    discountValidationSpan.textContent = '';
                    visibleDiscountInput.classList.remove('is-invalid');
                }
            }

            if (visiblePriceInput) {
                visiblePriceInput.addEventListener('input', () => {
                    formatVisiblePrice();
                    validatePriceVsDiscount();
                });
                initializePrice();
            }

            if (visibleDiscountInput) { 
                visibleDiscountInput.addEventListener('input', () => {
                    formatVisibleDiscount();
                    validatePriceVsDiscount(); 
                });
                initializeDiscount();
            }

            validatePriceVsDiscount();
        });
    </script>
}

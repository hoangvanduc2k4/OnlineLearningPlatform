@model IPagedList<OnlineLearningPlatform.Models.Entities.CoursePart.Course>
@using OnlineLearningPlatform.Enums
@using X.PagedList
@using X.PagedList.Mvc.Core
@{
    ViewData["Title"] = "Course Management";
    Layout = "~/Areas/Mentor/Views/Shared/_Layout.cshtml";

    var searchTerm = ViewData["SearchTerm"] as string;
    var sortBy = ViewData["SortBy"] as string;
    var status = ViewData["Status"] as CourseStatus?; 
}

<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Manage Courses</h4>

        <form method="get" asp-action="Index" class="d-flex align-items-center">

            <select name="status" class="form-select form-select-sm me-2" style="width: 150px;">
                <option value="">-- All Statuses --</option>
                @foreach (var s in Enum.GetValues<CourseStatus>().Where(s => s != CourseStatus.Deleted))
                {
                    <option value="@s" selected="@(status == s)">@s</option>
                }
            </select>

            <select name="sortBy" class="form-select form-select-sm me-2" style="width: 200px;">
                <option value="name_asc" selected="@(sortBy == "name_asc" || sortBy == null)">Sort by Name (A-Z)</option>
                <option value="name_desc" selected="@(sortBy == "name_desc")">Sort by Name (Z-A)</option>
                <option value="date_desc" selected="@(sortBy == "date_desc")">Newest First</option>
                <option value="date_asc" selected="@(sortBy == "date_asc")">Oldest First</option>
                <option value="price_desc" selected="@(sortBy == "price_desc")">Price (High-Low)</option>
                <option value="price_asc" selected="@(sortBy == "price_asc")">Price (Low-High)</option>
            </select>

            <input type="text" name="searchTerm" value="@searchTerm" class="form-control form-control-sm me-2" placeholder="Search Course..." />

            <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
        </form>

        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Create New Course</a>
    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Course Name</th>
                        <th>Price</th>
                        <th class="text-center">Status</th>
                        <th>Date Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.CourseName</strong></td>
                                <td>$@item.Price.ToString("N2")</td>
                                <td class="text-center">
                                    @{
                                        string statusClass = "";
                                        switch (item.Status)
                                        {
                                            case CourseStatus.Approved: statusClass = "bg-success"; break;
                                            case CourseStatus.Pending: statusClass = "bg-warning text-dark"; break;
                                            case CourseStatus.Draft: statusClass = "bg-secondary"; break;
                                            case CourseStatus.Rejected: statusClass = "bg-danger"; break;
                                        }
                                    }
                                    <span class="badge @statusClass">@item.Status</span>
                                </td>
                                <td>@item.CreatedAt.ToString("dd MMM, yyyy")</td>
                                <td class="text-end">
                                    @if (item.Status != CourseStatus.Pending)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.CourseId" title="Edit">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>

                                        <a class="btn btn-sm btn-outline-info"
                                           asp-area="Mentor" asp-page="/Courses/Manage" asp-route-id="@item.CourseId"
                                           title="Manage Content">
                                            <i class="bi bi-list-ul"></i>
                                        </a>
                                        <form method="post" asp-action="Delete" asp-route-id="@item.CourseId" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"
                                                    onclick="return confirm('Are you sure you want to delete the course: @item.CourseName?')">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No courses found matching your criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer bg-white">
        <nav aria-label="Page navigation" class="d-flex justify-content-center">
            @Html.PagedListPager(Model, page => Url.Action("Index",
            new { pageNumber = page, searchTerm = searchTerm, sortBy = sortBy, status = status }),
                        new PagedListRenderOptions
                        {
                            UlElementClasses = new[] { "pagination pagination-sm mb-0" },
                            LiElementClasses = new[] { "page-item" },
                            PageClasses = new[] { "page-link" }
                        })
        </nav>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js"></script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
}
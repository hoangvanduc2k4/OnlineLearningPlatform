@model IEnumerable<OnlineLearningPlatform.Models.Entities.CoursePart.Course>
@using OnlineLearningPlatform.Enums

@{
    ViewData["Title"] = "Course Management";
    Layout = "~/Areas/Mentor/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Your Courses</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Create New Course</a>
    </div>

    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Course Name</th>
                        <th>Price</th>
                        <th class="text-center">Status</th>
                        <th>Date Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.CourseName</strong></td>
                                <td>$@item.Price.ToString("N2")</td>
                                <td class="text-center">
                                    @{
                                        string statusClass = "";
                                        switch (item.Status)
                                        {
                                            case CourseStatus.Approved:
                                                statusClass = "bg-success";
                                                break;
                                            case CourseStatus.Pending:
                                                statusClass = "bg-warning text-dark";
                                                break;
                                            case CourseStatus.Draft:
                                                statusClass = "bg-secondary";
                                                break;
                                            case CourseStatus.Rejected:
                                                statusClass = "bg-danger";
                                                break;
                                        }
                                    }
                                    <span class="badge @statusClass">@item.Status</span>
                                </td>
                                <td>@item.CreatedAt.ToString("dd MMM, yyyy")</td>
                                <td class="text-end">
                                    @if (item.Status != CourseStatus.Pending)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.CourseId" title="Edit">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>

                                        <a class="btn btn-sm btn-outline-info"
                                           href="/Mentor/Courses/Manage/@item.CourseId"
                                           title="Manage Content">
                                            <i class="bi bi-list-ul"></i>
                                        </a>
                                        <form method="post" asp-action="Delete" asp-route-id="@item.CourseId" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"
                                            onclick="return confirm('Are you sure you want to delete the course: @item.CourseName?')">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                                    </tr>
                        }
                    }
                    else
                    {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    You haven't created any courses yet.
                                </td>
                            </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@page
@using X.PagedList
@using X.PagedList.Mvc.Core
@model OnlineLearningPlatform.Areas.Mentor.Pages.Quizzes.UpdateModel
@using OnlineLearningPlatform
@using OnlineLearningPlatform.Models
@using OnlineLearningPlatform.Enums
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Update Quiz";
    Layout = "~/Areas/Mentor/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light text-primary">
            <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Update Quiz</h5>
        </div>

        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Quiz.QuizId" />

                <div class="mb-3">
                    <label asp-for="Quiz.QuizName" class="form-label">Quiz Name</label>
                    <input asp-for="Quiz.QuizName" class="form-control" />
                    <span asp-validation-for="Quiz.QuizName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quiz.ModuleId" class="form-label">Module</label>
                    <select asp-for="Quiz.ModuleId" class="form-select" asp-items="Model.AvailableModules">
                        <option value="">-- Select Module --</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Quiz.QuizTime" class="form-label">Quiz Time</label>
                        <input asp-for="Quiz.QuizTime" type="number" class="form-control" min="1" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Quiz.TimeUnit" class="form-label">Time Unit</label>
                        <select asp-for="Quiz.TimeUnit" class="form-select">
                            <option value="Minute">Minute</option>
                            <option value="Second">Second</option>
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Quiz.PassScore" class="form-label">Pass Score</label>
                        <input asp-for="Quiz.PassScore" type="number" class="form-control" min="0" />
                    </div>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Quiz.IsActived" class="form-check-input" />
                    <label asp-for="Quiz.IsActived" class="form-check-label">Active</label>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-page="./Index" class="btn btn-outline-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
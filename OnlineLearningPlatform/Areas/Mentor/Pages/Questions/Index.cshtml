@page
@using X.PagedList
@using X.PagedList.Mvc.Core
@model OnlineLearningPlatform.Areas.Mentor.Pages.Questions.IndexModel
@using OnlineLearningPlatform
@using OnlineLearningPlatform.Models
@using OnlineLearningPlatform.Enums
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Question Management";
    Layout = "~/Areas/Mentor/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light text-primary d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
        <a asp-area="Mentor" asp-page="/Quizzes/Index"
           class="btn btn-sm btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h5 class="mb-0 fw-bold text-primary">Questions for @Model.QuizName</h5>
    </div>

    <div class="d-flex align-items-center">
        <form method="get" class="d-flex align-items-center me-3">
            <input type="hidden" name="quizId" value="@Model.QuizId" />
            <input type="text" name="searchTerm" value="@Model.SearchTerm"
                   class="form-control form-control-sm me-2"
                   placeholder="Search question..." />
            <button type="submit" class="btn btn-sm btn-outline-primary me-2">Filter</button>
            <a asp-page="./Index" asp-route-quizId="@Model.QuizId"
               class="btn btn-sm btn-outline-secondary">Reset</a>
        </form>

        <a asp-area="Mentor"
           asp-page="/Questions/Create"
           asp-route-quizId="@Model.QuizId"
           class="btn btn-sm btn-success">
            <i class="bi bi-plus-lg"></i> Add Question
        </a>
    </div>
</div>


        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model.PagedQuestions != null && Model.PagedQuestions.Any())
            {
                <ul class="list-group">
                    @foreach (var q in Model.PagedQuestions)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start flex-column flex-md-row">
                            <div class="flex-grow-1">
                                <strong class="text-dark">@q.QuestionContent</strong>
                                <ul class="mt-2 mb-0">
                                    @foreach (var o in q.Options)
                                    {
                                        <li class="@((o.IsCorrect ? "text-success fw-bold" : ""))">
                                            @o.OptionText
                                            @if (o.IsCorrect)
                                            {
                                                <i class="bi bi-check-circle-fill ms-1 text-success"></i>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="mt-2 mt-md-0 text-end">
                                <a class="btn btn-sm btn-warning me-1"
                                   asp-page="Update"
                                   asp-route-questionId="@q.QuestionId"
                                   asp-route-quizId="@Model.QuizId">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>

                                <form method="post" asp-page-handler="Delete" class="d-inline">
                                    <input type="hidden" name="questionId" value="@q.QuestionId" />
                                    <input type="hidden" name="quizId" value="@Model.QuizId" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this question?')">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="alert alert-info mb-0">No questions found.</div>
            }
        </div>

        <div class="card-footer bg-white">
            <nav aria-label="Page navigation" class="d-flex justify-content-center">
                @Html.PagedListPager(
    Model.PagedQuestions,
    page => Url.Page("./Index", new { 
        quizId = Model.QuizId, 
        pageNumber = page, 
        pageSize = Model.PageSize, 
        searchTerm = Model.SearchTerm 
    }),
    new PagedListRenderOptions
    {
        UlElementClasses = new[] { "pagination pagination-sm mb-0" },
        LiElementClasses = new[] { "page-item" },
        PageClasses = new[] { "page-link text-primary" }
    })

            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showSuccess(msg) {
            iziToast.success({
                title: 'Success',
                message: msg,
                backgroundColor: '#d4edda',
                titleColor: '#155724',
                messageColor: '#155724',
                position: 'topRight'
            });
        }

        function showError(msg) {
            iziToast.error({
                title: 'Error',
                message: msg,
                backgroundColor: '#f8d7da',
                titleColor: '#721c24',
                messageColor: '#721c24',
                position: 'topRight'
            });
        }
    </script>
}

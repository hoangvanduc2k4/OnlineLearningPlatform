@page "{quizId:long}"
@model OnlineLearningPlatform.Areas.Mentor.Pages.Questions.CreateModel
@using OnlineLearningPlatform
@using OnlineLearningPlatform.Models
@using OnlineLearningPlatform.Enums
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Create Question";
    Layout = "~/Areas/Mentor/Views/Shared/_Layout.cshtml";
}

<h2>Add Question to Quiz: @Model.QuizName</h2>

<form method="post" onsubmit="return validateForm()">
    <input type="hidden" asp-for="Question.QuizId" />

    <div class="mb-3">
        <label>Question:</label>
        <input type="text" class="form-control" asp-for="Question.QuestionContent" id="questionContent" />
        <span class="text-danger" id="questionError"></span>
    </div>

    <div id="answers-container">
        <!-- dynamically added options -->
    </div>

    <button type="button" class="btn btn-secondary mb-2" id="add-answer">Add Answer</button>
    <button type="submit" class="btn btn-success">Save</button>
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let answerIndex = 0;
        $('#add-answer').click(function () {
            const container = $('#answers-container');
            const row = $(`
                <div class="d-flex mb-2 align-items-center answer-row">
                    <input type="text" name="Question.Options[${answerIndex}].OptionText" class="form-control me-2" placeholder="Answer">
                    <input type="checkbox" name="Question.Options[${answerIndex}].IsCorrect" value="true" class="form-check-input me-2">
                    <input type="hidden" name="Question.Options[${answerIndex}].IsCorrect" value="false">
                    <button type="button" class="btn btn-danger btn-sm">×</button>
                </div>
            `);
            row.find('button').click(() => row.remove());
            container.append(row);
            answerIndex++;
        });

        function validateForm() {
            let valid = true;
            if ($('#questionContent').val().trim() === '') {
                $('#questionError').text('Question cannot be empty');
                valid = false;
            } else {
                $('#questionError').text('');
            }

            if ($('#answers-container .answer-row').length === 0) {
                alert('Add at least one answer');
                valid = false;
            }

            if ($('#answers-container .answer-row input[type=checkbox]:checked').length === 0) {
                alert('Select at least one correct answer');
                valid = false;
            }

            return valid;
        }
    </script>
}

@page "{id:long}"
@model OnlineLearningPlatform.Areas.Mentor.Pages.Lessons.EditModel
@using OnlineLearningPlatform.Enums
@{
    ViewData["Title"] = "Edit Lesson";
    Layout = "~/Areas/Mentor/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center">
    <a asp-page="/Courses/Manage" asp-area="Mentor"
       asp-route-id="@Model.LessonVM.CourseId"
       asp-route-moduleId="@Model.LessonVM.ModuleId"
       class="btn btn-sm btn-outline-secondary me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="mb-0 fs-3">Edit Lesson</h1>
</div>
<hr />

<div class="row">
    <div class="col-md-9">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="LessonVM.LessonId" />
            <input type="hidden" asp-for="LessonVM.ModuleId" />
            <input type="hidden" asp-for="LessonVM.CourseId" />

            <div class="form-group">
                <label class="control-label">Course</label>
                <input type="text" class="form-control" value="@ViewData["CourseName"]" readonly />
            </div>

            <div class="form-group">
                <label class="control-label">Module</label>
                <input type="text" class="form-control" value="@ViewData["ModuleName"]" readonly />
            </div>
            <hr />

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="LessonVM.LessonNumber" class="control-label"></label>
                <input asp-for="LessonVM.LessonNumber" class="form-control" type="number" />
                <span asp-validation-for="LessonVM.LessonNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="LessonVM.LessonName" class="control-label"></label>
                <input asp-for="LessonVM.LessonName" class="form-control" />
                <span asp-validation-for="LessonVM.LessonName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LessonVM.LessonContent" class="control-label"></label>
                <textarea asp-for="LessonVM.LessonContent" class="form-control" rows="8"></textarea>
                <span asp-validation-for="LessonVM.LessonContent" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LessonVM.LessonVideo" class="control-label"></label>
                <input asp-for="LessonVM.LessonVideo" class="form-control" />
                <span asp-validation-for="LessonVM.LessonVideo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LessonVM.Duration" class="control-label"></label>
                <input asp-for="LessonVM.Duration" class="form-control" />
                <span asp-validation-for="LessonVM.Duration" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="LessonVM.Status" class="control-label"></label>
                <select asp-for="LessonVM.Status" class="form-control" asp-items="Html.GetEnumSelectList<CommonStatus>()">
                    <option value="">-- Select Status --</option>
                </select>
                <span asp-validation-for="LessonVM.Status" class="text-danger"></span>
            </div>

            <div class="form-group mt-3 d-flex justify-content-between">
                <div>
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a asp-page="/Courses/Manage" asp-area="Mentor" asp-route-id="@Model.LessonVM.CourseId" asp-route-moduleId="@Model.LessonVM.ModuleId" class="btn btn-outline-secondary">
                        Back
                    </a>
                </div>

                <div>
                    <button type="submit" class="btn btn-danger"
                            asp-page-handler="Delete"
                            onclick="return confirm('Are you sure you want to delete this lesson?')">
                        <i class="bi bi-trash"></i> 
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
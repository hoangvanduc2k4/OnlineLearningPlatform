@page "{moduleId:long}/{courseId:long}"
@model OnlineLearningPlatform.Areas.Mentor.Pages.Lessons.CreateModel
@using OnlineLearningPlatform.Enums
@{
    ViewData["Title"] = "Create Lesson";
    Layout = "~/Areas/Mentor/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center">
    <a asp-page="/Courses/Manage" asp-area="Mentor" 
       asp-route-id="@Model.LessonVM.CourseId"
       asp-route-moduleId="@Model.LessonVM.ModuleId" 
       class="btn btn-sm btn-outline-secondary me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="mb-0 fs-3">Create New Lesson</h1>
</div>
<hr />

<div class="row">
    <div class="col-md-9">
        <form method="post" enctype="multipart/form-data" id="lessonForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="LessonVM.ModuleId" />
            <input type="hidden" asp-for="LessonVM.CourseId" />

            <div class="form-group">
                <label class="control-label">Course</label>
                <input type="text" class="form-control" value="@ViewData["CourseName"]" readonly />
            </div>

            <div class="form-group">
                <label class="control-label">Module</label>
                <input type="text" class="form-control" value="@ViewData["ModuleName"]" readonly />
            </div>

            <hr /> <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="LessonVM.LessonNumber" class="control-label"></label>
                <input asp-for="LessonVM.LessonNumber" class="form-control" type="number" />
                <span asp-validation-for="LessonVM.LessonNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="LessonVM.LessonName" class="control-label"></label>
                <input asp-for="LessonVM.LessonName" class="form-control" />
                <span asp-validation-for="LessonVM.LessonName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LessonVM.LessonContent" class="control-label"></label>
                <textarea asp-for="LessonVM.LessonContent" class="form-control" rows="8"></textarea>
                <span asp-validation-for="LessonVM.LessonContent" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Video</label>
                <div class="mb-2">
                    <small class="text-muted">You may either enter an external video URL or upload a video file. If you upload a file it will be used.</small>
                </div>

                <div class="mb-2">
                    <label asp-for="LessonVM.LessonVideo" class="form-label">External video URL</label>
                    <input asp-for="LessonVM.LessonVideo" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="LessonVM.LessonVideo" class="text-danger"></span>
                </div>

                <div class="mb-2">
                    <label class="form-label">Or upload video file</label>
                    <input type="file" name="VideoFile" id="videoFileInput" accept=".mp4,.mov,.webm,.ogg" class="form-control" />
                    <small class="form-text text-muted">Allowed: mp4, mov, webm, ogg. Max 200 MB.</small>
                    <div id="uploadError" class="text-danger mt-1" role="alert" style="display:none;"></div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="LessonVM.Duration" class="control-label"></label>
                <input asp-for="LessonVM.Duration" class="form-control"/>
                <span asp-validation-for="LessonVM.Duration" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="LessonVM.Status" class="control-label"></label>
                <select asp-for="LessonVM.Status" class="form-control" asp-items="Html.GetEnumSelectList<CommonStatus>()">
                    <option value="">-- Select Status --</option>
                </select>
                <span asp-validation-for="LessonVM.Status" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-page="/Courses/Manage" asp-area="Mentor"
                   asp-route-id="@Model.LessonVM.CourseId"
                   asp-route-moduleId="@Model.LessonVM.ModuleId" class="btn btn-outline-secondary">
                    Back
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ 
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function(){
            const maxBytes = 200 * 1024 * 1024; // 200MB
            const form = document.getElementById('lessonForm');
            const fileInput = document.getElementById('videoFileInput');
            const errorDiv = document.getElementById('uploadError');

            if (form && fileInput) {
                form.addEventListener('submit', function(e){
                    errorDiv.style.display = 'none';
                    errorDiv.innerText = '';
                    const f = fileInput.files && fileInput.files[0];
                    if (f) {
                        if (f.size > maxBytes) {
                            e.preventDefault();
                            errorDiv.style.display = 'block';
                            errorDiv.innerText = 'File quá lớn. Kích thước tối đa 200 MB.';
                            fileInput.focus();
                            return false;
                        }
                    }
                });

                // optional: show immediate feedback on file select
                fileInput.addEventListener('change', function(){
                    errorDiv.style.display = 'none';
                    errorDiv.innerText = '';
                    const f = fileInput.files && fileInput.files[0];
                    if (f && f.size > maxBytes) {
                        errorDiv.style.display = 'block';
                        errorDiv.innerText = 'File quá lớn. Kích thước tối đa 200 MB.';
                    }
                });
            }
        })();
    </script>
}
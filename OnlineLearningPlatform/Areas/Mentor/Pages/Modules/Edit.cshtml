@page
@model OnlineLearningPlatform.Areas.Mentor.Pages.Modules.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Mentor/Views/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>Module</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Module.ModuleId" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Module.ModuleName" class="control-label"></label>
                <input asp-for="Module.ModuleName" class="form-control" />
                <span asp-validation-for="Module.ModuleName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Module.CourseId" class="control-label"></label>
                <select asp-for="Module.CourseId" class="form-control" asp-items="ViewBag.CourseId"></select>
                <span asp-validation-for="Module.CourseId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Module.ModuleNumber" class="control-label"></label>
                <input asp-for="Module.ModuleNumber" class="form-control" />
                <span asp-validation-for="Module.ModuleNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Module.Status" class="control-label"></label>
                <select asp-for="Module.Status" class="form-control"></select>
                <span asp-validation-for="Module.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Module.DateCreated" class="control-label"></label>
                <input asp-for="Module.DateCreated" class="form-control" />
                <span asp-validation-for="Module.DateCreated" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Module.ModifiedDate" class="control-label"></label>
                <input asp-for="Module.ModifiedDate" class="form-control" />
                <span asp-validation-for="Module.ModifiedDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

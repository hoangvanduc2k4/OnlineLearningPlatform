@page
@model OnlineLearningPlatform.Areas.Mentee.Pages.MentorApplications.MyApplicationsModel
@{
    ViewData["Title"] = "My Mentor Applications";
    Layout = "~/Areas/Mentee/Shared/_MenteeLayout.cshtml";
}

<h2>My Mentor Applications</h2>

@if (Model.Applications == null || !Model.Applications.Any())
{
    <div class="alert alert-info">You have not submitted any mentor applications yet.</div>
}
else
{
    <div id="myApplicationsContainer">
    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>CV</th>
                <th>Note</th>
                <th>Status</th>
                <th>Submitted At</th>
                <th>Reviewed At</th>
                <th>Feedback</th>
            </tr>
        </thead>
        <tbody>
        @for (int i = 0; i < Model.Applications.Count; i++)
        {
            var app = Model.Applications[i];
            <tr>
                <td>@(i + 1)</td>
                <td>
                    <a href="@app.CvUrl" target="_blank">View CV</a>
                </td>
                <td>@app.Note</td>
                <td>
                    @switch (app.Status)
                    {
                        case OnlineLearningPlatform.Enums.ApplicationStatus.Pending:
                            <span class="badge bg-warning text-dark">Pending</span>
                            break;
                        case OnlineLearningPlatform.Enums.ApplicationStatus.Approved:
                            <span class="badge bg-success">Approved</span>
                            break;
                        case OnlineLearningPlatform.Enums.ApplicationStatus.Rejected:
                            <span class="badge bg-danger">Rejected</span>
                            break;
                    }
                </td>
                <td>@app.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(app.ReviewedAt.HasValue ? app.ReviewedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                    <td>@(string.IsNullOrEmpty(app.Feedback) ? "-" : app.Feedback)</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

@section Scripts {
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/crudHub')
            .withAutomaticReconnect()
            .build();

        connection.start()
            .then(() => console.log('Connected to SignalR Hub'))
            .catch(err => console.error(err.toString()));

        connection.on('loadMentorApplications', function () {
            // fetch updated applications for current user
            fetch(window.location.pathname, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(res => res.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const partial = doc.querySelector('#myApplicationsContainer');
                    if (partial) {
                        console.log(html);
                        document.getElementById('myApplicationsContainer').innerHTML = partial.innerHTML;
                    }
                    // otherwise reload full page as fallback
                    else window.location.reload();
                })
                .catch(err => console.error(err));
        });
    </script>
}

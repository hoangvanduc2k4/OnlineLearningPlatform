@page
@using X.PagedList
@using X.PagedList.Mvc.Core
@model OnlineLearningPlatform.Areas.Admin.Pages.ReviewCourses.IndexModel
@{
    ViewData["Title"] = "Courses Pending Review";
    Layout = "~/Areas/Admin/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Courses Pending Review</h4>

            <form method="get" class="d-flex ms-auto">
                <select name="SortBy" class="form-select form-select-sm me-2" onchange="this.form.submit()" style="width: 180px;">
                    <option value="date_desc" selected="@(Model.SortBy == "date_desc" || Model.SortBy == null)">Sort by Newest</option>
                    <option value="date_asc" selected="@(Model.SortBy == "date_asc")">Sort by Oldest</option>
                    <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Sort by Name (A-Z)</option>
                    <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Sort by Name (Z-A)</option>
                    <option value="mentor_asc" selected="@(Model.SortBy == "mentor_asc")">Sort by Mentor (A-Z)</option>
                    <option value="mentor_desc" selected="@(Model.SortBy == "mentor_desc")">Sort by Mentor (Z-A)</option>
                </select>

                <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control form-control-sm me-2" placeholder="Search Course or Mentor..." />
                <button type="submit" class="btn btn-sm btn-outline-primary">Search</button>
            </form>
        </div>

        <div class="card-body p-0">
            @if (TempData["SuccessMessage"] != null)
            {
            }
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th>ID</th>
                            <th>Course Name</th>
                            <th>Mentor</th>
                            <th>Date Submitted</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PendingCourses != null && Model.PendingCourses.Any())
                        {
                            @foreach (var course in Model.PendingCourses)
                            {
                                <tr>
                                    <td>@course.CourseId</td>
                                    <td>@course.CourseName</td>
                                    <td>@course.CreatorUser.FullName</td>
                                    <td>@(course.UpdatedAt?.ToString("dd/MM/yyyy"))</td>
                                    <td class="text-end">
                                        <a asp-page="./Details" asp-route-id="@course.CourseId" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye-fill"></i> Review
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No courses found matching your criteria.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white">
            <nav aria-label="Page navigation" class="d-flex justify-content-center">

                @Html.PagedListPager(Model.PendingCourses, page => Url.Page("./Index",
                new { pageNumber = page, searchTerm = Model.SearchTerm, sortBy = Model.SortBy }),
                                new PagedListRenderOptions
                                {
                                    UlElementClasses = new[] { "pagination pagination-sm mb-0" },
                                    LiElementClasses = new[] { "page-item" },
                                    PageClasses = new[] { "page-link" }
                                })
            </nav>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/site.js"></script>
}
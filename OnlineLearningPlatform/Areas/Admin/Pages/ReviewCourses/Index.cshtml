@page
@using X.PagedList
@using X.PagedList.Mvc.Core
@model OnlineLearningPlatform.Areas.Admin.Pages.ReviewCourses.IndexModel
@{
    ViewData["Title"] = "Courses Pending Review";
    Layout = "~/Areas/Admin/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light">
            <h4 class="mb-0">Courses Pending Review</h4>
        </div>
        <div class="card-body p-0">
            @if (TempData["SuccessMessage"] != null)
            {
                    <div class="m-3 alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
            }
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th>Course Name</th>
                            <th>Mentor</th>
                            <th>Price</th>
                            <th>Date Submitted</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PendingCourses != null && Model.PendingCourses.Any())
                        {
                            @foreach (var course in Model.PendingCourses)
                            {
                                        <tr>
                                            <td><strong>@course.CourseName</strong></td>
                                            <td>@course.CreatorUser.FullName</td>
                                            <td>$@course.Price.ToString("N2")</td>
                                            <td>@(course.UpdatedAt?.ToString("dd MMM, yyyy"))</td>
                                            <td class="text-end">
                                                <a asp-page="./Details" asp-route-id="@course.CourseId" class="btn btn-sm btn-primary">
                                                    <i class="bi bi-eye-fill"></i> Review
                                                </a>
                                            </td>
                                        </tr>
                            }
                        }
                        else
                        {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No courses are currently pending review.</td>
                                </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white">
            <nav aria-label="Page navigation" class="d-flex justify-content-center">
                @Html.PagedListPager(Model.PendingCourses, page => Url.Page("./Index", new { pageNumber = page }),
                             new PagedListRenderOptions
                    {
                        UlElementClasses = new[] { "pagination pagination-sm mb-0" },
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
            </nav>
        </div>
    </div>
</div>
@page "{id:long}"
@using OnlineLearningPlatform.Enums
@model OnlineLearningPlatform.Areas.Admin.Pages.ReviewCourses.DetailsModel
@{
    ViewData["Title"] = "Review Course";
    Layout = "~/Areas/Admin/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <a asp-page="./Index" class="btn btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Back to List</a>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header"><h4>Course Details</h4></div>
                <div class="card-body">
                    <h3>@Model.CourseToReview.CourseName</h3>
                    <p class="text-muted">Submitted by: <strong>@Model.CourseToReview.CreatorUser.FullName</strong></p>
                    <hr />

                    <h5>Cover Image</h5>
                    @if (Model.CourseToReview.CourseImageUrls.Any())
                    {
                            <img src="@Model.CourseToReview.CourseImageUrls.First().Url" alt="Course Image" class="img-fluid rounded mb-3" style="max-height: 300px;" />
                    }
                    else
                    {
                            <p class="text-muted fst-italic">No cover image provided.</p>
                    }
                    <hr />

                    <h5>Description</h5>
                    <div>@Html.Raw(Model.CourseToReview.Description)</div>
                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-3"><strong>Price:</strong> @Model.CourseToReview.Price.ToString("N2") VND</div>
                        <div class="col-md-3">
                            <strong>Discount:</strong>
                            @((Model.CourseToReview.Discount ?? 0).ToString("N2")) VND
                        </div>
                        <div class="col-md-3"><strong>Level:</strong> @Model.CourseToReview.Level?.LevelName</div>
                        <div class="col-md-3"><strong>Study Time:</strong> @Model.CourseToReview.StudyTime</div>
                    </div>
                    <hr />

                    <h5>Categories</h5>
                    @if (Model.CourseToReview.CourseCategories.Any())
                    {
                            <div>
                            @foreach (var courseCategory in Model.CourseToReview.CourseCategories)
                            {
                                        <span class="badge text-bg-secondary me-1 fs-6">@courseCategory.Category.CategoryName</span>
                            }
                            </div>
                    }
                    else
                    {
                            <p class="text-muted fst-italic">No categories assigned.</p>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                 <div class="card-header"><h4>Course Content</h4></div>
                 <div class="card-body">
                    @if (Model.CourseToReview.Modules.Any())
                    {
                        <div class="accordion" id="courseContentAccordion">
                            @foreach (var module in Model.CourseToReview.Modules.OrderBy(m => m.ModuleNumber))
                            {
                                <div class="accordion-item mb-2">
                                    <h2 class="accordion-header" id="heading-@module.ModuleId">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@module.ModuleId" aria-expanded="false">
                                            <strong>Module @module.ModuleNumber: @module.ModuleName</strong>
                                        </button>
                                    </h2>
                                    <div id="collapse-@module.ModuleId" class="accordion-collapse collapse" data-bs-parent="#courseContentAccordion">
                                        <div class="accordion-body">
                                            <ul class="list-group list-group-flush">
                                                @foreach (var lesson in module.Lessons.OrderBy(l => l.LessonNumber))
                                                {
                                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                                        <span>
                                                            <i class="bi bi-file-text me-2"></i>
                                                            Lesson @lesson.LessonNumber: @lesson.LessonName
                                                        </span>
                                                    </li>
                                                }
                                                @foreach (var quiz in module.Quizzes)
                                                {
                                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                                        <span>
                                                            <i class="bi bi-patch-question me-2"></i>
                                                            Quiz: @quiz.QuizName
                                                        </span>
                                                    </li>
                                                }
                                                @if (!module.Lessons.Any() && !module.Quizzes.Any())
                                                {
                                                    <li class="list-group-item text-muted fst-italic">This module is empty.</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic">This course has no modules.</p>
                    }
                 </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header"><h4>Review Action</h4></div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="ReviewInput.ReviewNotes" class="form-label"></label>
                            <textarea asp-for="ReviewInput.ReviewNotes" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="ReviewInput.ReviewNotes" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" asp-page-handler="Approve" class="btn btn-success">
                                <i class="bi bi-check-circle-fill"></i> Approve
                            </button>
                            <button type="submit" asp-page-handler="Reject" class="btn btn-danger">
                                <i class="bi bi-x-circle-fill"></i> Reject
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/site.js"></script>
}
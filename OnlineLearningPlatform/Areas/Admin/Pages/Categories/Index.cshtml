@page
@using X.PagedList
@using X.PagedList.Mvc.Core
@model OnlineLearningPlatform.Areas.Admin.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Category Management";
    Layout = "~/Areas/Admin/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light text-primary d-flex justify-content-between align-items-center">
            <form method="get" class="d-flex me-2">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm me-2" placeholder="Search Category..." />
                <button type="submit" class="btn btn-sm btn-outline-primary">Search</button>
            </form>
            <a asp-page="./Create" class="btn btn-sm btn-success"><i class="bi bi-plus-lg"></i> Add New Category</a>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th style="width: 5%;">ID</th>
                            <th style="width: 40%;">Category Name</th>
                            <th style="width: 15%;">Status</th>
                            <th style="width: 15%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="categoryTableBody">
                        @if (Model.Categories != null && Model.Categories.Any())
                        {
                            int seq = (Model.Categories.PageNumber - 1) * Model.Categories.PageSize;
                            foreach (var category in Model.Categories)
                            {
                                seq++;
                                <tr id="category_@category.CategoryId">

                                    <td>@seq</td>
                                    <td>@category.CategoryName</td>
                                    <td>
                                        <span class="badge @(category.IsDeleted ? "text-danger" : "text-success")">
                                            @(category.IsDeleted ? "Deleted" : "Active")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-page="./Update" asp-route-id="@category.CategoryId" class="btn btn-sm btn-warning me-1">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <form method="post" asp-page-handler="Delete" class="d-inline">
                                            <input type="hidden" name="id" value="@category.CategoryId" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this?')">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-3 text-muted">No Categories found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white">
            <nav aria-label="Page navigation" class="d-flex justify-content-center">
                @Html.PagedListPager(Model.Categories, page => Url.Page("./Index", new { pageNumber = page, pageSize = Model.PageSize, searchTerm = Model.SearchTerm }),
                         new PagedListRenderOptions
                {
                    UlElementClasses = new[] { "pagination pagination-sm mb-0" },
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link text-primary" }
                })
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Hàm tạo HTML cho row
        function getRowHtml(category, seq) {
            const statusHtml = category.isDeleted
                ? '<span class="badge text-danger">Deleted</span>'
                : '<span class="badge text-success">Active</span>';

            return `
                <tr id="category_${category.categoryId}">
                    <td>${seq}</td>
                    <td>${category.categoryName}</td>
                    <td>${statusHtml}</td>
                    <td>
                        <a asp-page="./Update" asp-route-id="${category.categoryId}" class="btn btn-sm btn-warning me-1">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <form method="post" asp-page-handler="Delete" class="d-inline">
                            <input type="hidden" name="id" value="${category.categoryId}" />
                            <input type="hidden" name="pageNumber" value="@Model.Categories.PageNumber" />
                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                            <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this?')">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            `;
        }

        $(function () {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/crudHub")
                .withAutomaticReconnect()
                .build();

            connection.start().catch(function (err) {
                console.error(err.toString());
            });

            connection.on("CategoryDeleted", function (id) {
                const row = $("#category_" + id);
                if (row.length) {
                    row.remove();
                    if ($("#categoryTableBody tr").length === 0) {
                        $("#categoryTableBody").append('<tr><td colspan="4" class="text-center py-3 text-muted">No Categories found.</td></tr>');
                    }
                }
            });

            connection.on("CategoryCreated", function (category) {
                const tbody = $("#categoryTableBody");
                const currentRows = tbody.find("tr").length;
                const pageSize = @Model.PageSize;
                const noDataRow = tbody.find("tr td.text-center.text-muted");

                if (currentRows < pageSize || noDataRow.length) {
                    const seq = (@Model.Categories.PageNumber - 1) * pageSize + currentRows + 1;
                    if (noDataRow.length) {
                        noDataRow.parent().remove();
                    }
                    tbody.append(getRowHtml(category, seq));
                }
            });

            connection.on("CategoryUpdated", function (category) {
                const row = $("#category_" + category.categoryId);
                if (row.length) {
                    const seq = row.find("td:first").text();
                    row.replaceWith(getRowHtml(category, seq));
                }
            });
        });
    </script>
}
@page
@model OnlineLearningPlatform.Areas.Admin.Pages.Levels.IndexModel
@{
    ViewData["Title"] = "Level Management";
    Layout = "~/Areas/Admin/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card">
        <div class="card-header bg-light text-primary d-flex justify-content-end">
            <a asp-page="./Create" class="btn btn-sm btn-success"><i class="bi bi-plus-lg"></i>Add New Level</a>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Level Name</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="levelTableBody">
                    @if (Model.Levels != null && Model.Levels.Any())
                    {
                        int seq = 0;
                        foreach (var level in Model.Levels)
                        {
                            seq++;
                            <tr id="level_@level.LevelId">
                                <td>@seq</td>
                                <td>@level.LevelName</td>
                                <td>
                                    <span class="@(level.IsDeleted ? "text-danger" : "text-success")">
                                        @(level.IsDeleted ? "Deleted" : "Active")
                                    </span>
                                </td>
                                <td>
                                    <a asp-page="./Update" asp-route-id="@level.LevelId" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <form method="post" asp-page-handler="Delete" class="d-inline">
                                        <input type="hidden" name="id" value="@level.LevelId" />
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this?')">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">No Levels found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function getRowHtml(level, seq) {
            const statusHtml = level.isDeleted
                ? '<span class="text-danger">Deleted</span>'
                : '<span class="text-success">Active</span>';

            return `
                <tr id="level_${level.levelId}">
                    <td>${seq}</td>
                    <td>${level.levelName}</td>
                    <td>${statusHtml}</td>
                    <td>
                        <a asp-page="./Update" asp-route-id="${level.levelId}" class="btn btn-sm btn-warning me-1">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <form method="post" asp-page-handler="Delete" class="d-inline">
                            <input type="hidden" name="id" value="${level.levelId}" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this?')">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            `;
        }

        $(function () {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/crudHub")
                .withAutomaticReconnect()
                .build();

            connection.start().catch(function (err) {
                console.error(err.toString());
            });

            connection.on("LevelDeleted", function (id) {
                const row = $("#level_" + id);
                if (row.length) {
                    row.remove();
                    if ($("#levelTableBody tr").length === 0) {
                        $("#levelTableBody").append('<tr><td colspan="4" class="text-center py-3 text-muted">No Levels found.</td></tr>');
                    }
                }
            });

            connection.on("LevelCreated", function (level) {
                const tbody = $("#levelTableBody");
                const currentRows = tbody.find("tr").length;
                const noDataRow = tbody.find("tr td.text-center.text-muted");

                const seq = currentRows + 1;
                if (noDataRow.length) {
                    noDataRow.parent().remove();
                }
                tbody.append(getRowHtml(level, seq));
            });

            connection.on("LevelUpdated", function (level) {
                const row = $("#level_" + level.levelId);
                if (row.length) {
                    const seq = row.find("td:first").text();
                    row.replaceWith(getRowHtml(level, seq));
                }
            });
        });
    </script>
}
@model OnlineLearningPlatform.Areas.Admin.Pages.Users.IndexModel

@if (Model.PagedUsers != null && Model.PagedUsers.Any())
{
    int seq = (Model.PagedUsers.PageNumber - 1) * Model.PagedUsers.PageSize;
    foreach (var user in Model.PagedUsers)
    {
        seq++;
        <tr>
            <td>@seq</td>
            <td>@user.Email</td>
            <td>@user.FullName</td>
            <td>@(user.Dob.HasValue ? user.Dob.Value.ToString("dd/MM/yyyy") : "-")</td>
            <td>
                @if (user.Gender.HasValue)
                {
                    @(user.Gender.Value ? "Male" : "Female")
                }
                else
                {
                    <span>-</span>
                }
            </td>
            <td>@(user.Phone ?? "-")</td>
            <td>
                @if (Model.UserRoles != null && Model.UserRoles.ContainsKey(user.Id))
                {
                    @string.Join(", ", Model.UserRoles[user.Id])
                }
                else
                {
                    <span>-</span>
                }
            </td>
            <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
            <td>
                <a asp-page="./Update" asp-route-id="@user.Id" class="btn btn-sm btn-warning me-1">
                    <i class="bi bi-pencil-fill"></i>
                </a>
                @if (Model.FilterType == "deleted")
                {
                    <form method="post" asp-page-handler="Restore" class="d-inline">
                        <input type="hidden" name="id" value="@user.Id" />
                        <input type="hidden" name="pageNumber" value="@Model.PagedUsers.PageNumber" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" name="filterType" value="@Model.FilterType" />
                        <input type="hidden" name="role" value="@Model.SelectedRole" />
                        <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Are you sure you want to restore this user?')">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </form>
                }
                else if (Model.FilterType == "inactive")
                {
                    <form method="post" asp-page-handler="Restore" class="d-inline">
                        <input type="hidden" name="id" value="@user.Id" />
                        <input type="hidden" name="pageNumber" value="@Model.PagedUsers.PageNumber" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" name="filterType" value="@Model.FilterType" />
                        <input type="hidden" name="role" value="@Model.SelectedRole" />
                        <button type="submit" class="btn btn-sm btn-secondary me-1" onclick="return confirm('Are you sure you want to Activate this user?')">
                            <i class="bi bi-person-check-fill"></i>
                        </button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Delete" class="d-inline">
                        <input type="hidden" name="id" value="@user.Id" />
                        <input type="hidden" name="pageNumber" value="@Model.PagedUsers.PageNumber" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" name="filterType" value="@Model.FilterType" />
                        <input type="hidden" name="role" value="@Model.SelectedRole" />
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this user?')">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Deactivate" class="d-inline">
                        <input type="hidden" name="id" value="@user.Id" />
                        <input type="hidden" name="pageNumber" value="@Model.PagedUsers.PageNumber" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" name="filterType" value="@Model.FilterType" />
                        <input type="hidden" name="role" value="@Model.SelectedRole" />
                        <button type="submit" class="btn btn-sm btn-secondary" onclick="return confirm('Are you sure you want to deactivate this user?')">
                            <i class="bi bi-person-x-fill"></i>
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="9" class="text-center py-3 text-muted">No users found.</td>
    </tr>
}

@page
@using X.PagedList
@using X.PagedList.Mvc.Core
@model OnlineLearningPlatform.Areas.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Areas/Admin/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light text-primary d-flex justify-content-between align-items-center">
            <h5 class="mb-0">User Management</h5>
            <div class="d-flex">
                <form method="get" class="d-flex align-items-center">
                    <select name="filterType" class="form-select form-select-sm me-2" style="width: 140px;">
                        <option value="active" selected=@(Model.FilterType == "active")>Active</option>
                        <option value="inactive" selected=@(Model.FilterType == "inactive")>Inactive</option>
                        <option value="deleted" selected=@(Model.FilterType == "deleted")>Deleted</option>
                    </select>
                    <select name="role" class="form-select form-select-sm me-2" style="width: 140px;">
                        <option value="">All Roles</option>
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <option value="@role" selected=@(Model.SelectedRole == role)>@role</option>
                        }
                    </select>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm me-2" placeholder="Search user..." />
                    <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
                </form>
            </div>
        </div>

        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="bg-light text-dark">
                        <tr>
                            <th style="width: 2%;">#</th>
                            <th style="width: 18%;">Email</th>
                            <th style="width: 15%;">Full Name</th>
                            <th style="width: 10%;">DOB</th>
                            <th style="width: 10%;">Gender</th>
                            <th style="width: 12%;">Phone</th>
                            <th style="width: 10%;">Role</th>
                            <th style="width: 10%;">Created At</th>
                            <th style="width: 18%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        <partial name="_UserTablePartial" model="Model" />
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white">
            <nav aria-label="Page navigation" class="d-flex justify-content-center">
                @Html.PagedListPager(
                         Model.PagedUsers,
                         page => Url.Page("./Index", new { pageNumber = page, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, filterType = Model.FilterType, role = Model.SelectedRole }),
                         new PagedListRenderOptions
                         {
                             UlElementClasses = new[] { "pagination pagination-sm mb-0" },
                             LiElementClasses = new[] { "page-item" },
                             PageClasses = new[] { "page-link text-primary" }
                         })
            </nav>
        </div>
    </div>
</div>

<form method="post" asp-page-handler="ExportExcel" class="mb-3 mt-3" id="exportForm">
    <div id="exportOptions" style="display:none;">
        <label><input type="checkbox" name="statuses" value="active" /> Active</label>
        <label><input type="checkbox" name="statuses" value="inactive" /> Inactive</label>
        <label><input type="checkbox" name="statuses" value="deleted" /> Deleted</label>
        <button type="submit" class="btn btn-success btn-sm ms-2">Export Excel</button>
    </div>
    <button type="button" class="btn btn-success btn-sm ms-2" id="showExportOptionsBtn">Export Excel</button>
</form>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        function showSuccess(msg) {
            iziToast.success({
                title: 'Success',
                message: msg,
                backgroundColor: '#d4edda',
                titleColor: '#155724',
                messageColor: '#155724',
                position: 'topRight'
            });
        }

        function showError(msg) {
            iziToast.error({
                title: 'Error',
                message: msg,
                backgroundColor: '#f8d7da',
                titleColor: '#721c24',
                messageColor: '#721c24',
                position: 'topRight'
            });
        }

        document.getElementById('showExportOptionsBtn').addEventListener('click', function () {
            document.getElementById('exportOptions').style.display = 'block';
            this.style.display = 'none';
        });

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/crudHub")
            .build();

        connection.on("LoadUsers", function () {
            const url = window.location.href;
            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.text())
            .then(html => {
                document.getElementById('userTableBody').innerHTML = html;
                showSuccess('User list has been updated!');
            })
            .catch(err => console.error('Failed to reload user table:', err));
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });
    </script>
}